# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# Single-user guard: when true, sign-up is refused once a user exists.
# @public @type=boolean
SINGLE_USER=true

# Master sign-up switch: sign-up is refused unless true. Existing users still sign in.
# @public @type=boolean
SIGNUPS_ENABLED=true
